# Local Docker Compose template only. Copy this file to .env and replace every
# replace-* value before starting the application. Never commit the real .env.
APP_NAME=Todo AI
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+asyncpg://todo:replace-with-a-db-password@postgres:5432/todo
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=replace-with-a-db-password
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_ENABLED=true
REMINDER_WINDOW_MINUTES=15
AI_TIMEOUT_SECONDS=20
REFRESH_TOKEN_RETENTION_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
WEBSOCKET_TICKET_TTL_SECONDS=30
VITE_API_URL=/api/v1
VITE_WS_URL=
